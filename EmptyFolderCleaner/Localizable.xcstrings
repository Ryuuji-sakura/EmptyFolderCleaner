          }
        }
      }
    },
    "処理中です。中止するか、終わるのを待ってからもう一度ドロップしてください。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy. Stop the current task or wait for it to finish, then drop the folder again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorgang läuft. Den Vorgang stoppen oder abwarten und den Ordner dann erneut ablegen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang memproses. Hentikan tugas saat ini atau tunggu hingga selesai, lalu lepas folder lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang memproses. Hentikan tugas semasa atau tunggu sehingga selesai, kemudian lepaskan folder sekali lagi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리 중이에요. 중단하거나 끝날 때까지 기다린 다음 다시 드롭해 주세요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejder. Stop den igangværende opgave, eller vent til den er færdig, og slip derefter mappen igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดำเนินการอยู่ โปรดหยุดงานปัจจุบันหรือรอให้เสร็จก่อน แล้วจึงวางโฟลเดอร์อีกครั้ง"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處理中。請先停止目前作業或等待完成後，再重新拖放資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理中。请先停止当前任务或等待其完成，然后再次拖放文件夹。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocupado. Detén la tarea actual o espera a que termine y vuelve a soltar la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opération en cours. Arrêtez la tâche actuelle ou attendez la fin, puis déposez à nouveau le dossier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी प्रक्रिया चल रही है। वर्तमान कार्य रोकें या उसके पूरा होने की प्रतीक्षा करें, फिर फ़ोल्डर को दोबारा ड्रॉप करें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xử lý. Hãy dừng tác vụ hiện tại hoặc đợi hoàn tất rồi thả lại thư mục."
          }
        }
      }
    },
    "削除したものをゴミ箱に入れる（オフにすると元に戻せません）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move deleted items to the Trash (if turned off, they cannot be restored)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Objekte in den Papierkorb legen (wenn deaktiviert, nicht wiederherstellbar)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan item yang dihapus ke Sampah (jika dimatikan, tidak dapat dipulihkan)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alihkan item yang dipadam ke Tong Sampah (jika dimatikan, ia tidak boleh dipulihkan)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
