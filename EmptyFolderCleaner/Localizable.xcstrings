    "Finderの設定ファイルをすべて削除する（フォルダと中のファイルは残ります）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all Finder settings files (the folders and the files in them stay)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Finder-Einstellungsdateien löschen (Ordner und enthaltene Dateien bleiben erhalten)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua berkas pengaturan Finder (folder dan berkas di dalamnya tetap ada)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam semua fail tetapan Finder (folder dan fail di dalamnya kekal)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 설정 파일 모두 삭제(폴더와 안의 파일은 유지됨)"
          }
        },
        "da": {
