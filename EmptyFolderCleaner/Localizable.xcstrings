    "%@が見つかりました。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gefunden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditemukan %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditemui %@."
          }
        },
        "ko": {
