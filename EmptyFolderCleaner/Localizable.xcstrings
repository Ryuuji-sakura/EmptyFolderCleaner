            "value": "ลบไฟล์การตั้งค่า Finder ทั้งหมด (โฟลเดอร์และไฟล์ข้างในจะยังอยู่)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除所有 Finder 設定檔（保留資料夾與其中的檔案）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
