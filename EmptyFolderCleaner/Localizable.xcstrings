          }
        }
      }
    },
    "Finderの設定ファイル（.DS_Store）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder settings files (.DS_Store)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder-Einstellungsdateien (.DS_Store)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas pengaturan Finder (.DS_Store)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail tetapan Finder (.DS_Store)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 설정 파일(.DS_Store)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillingsfiler til Finder (.DS_Store)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์การตั้งค่า Finder (.DS_Store)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 設定檔（.DS_Store）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 设置文件（.DS_Store）"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de ajustes del Finder (.DS_Store)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de réglages du Finder (.DS_Store)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder सेटिंग्स फ़ाइलें (.DS_Store)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp cài đặt Finder (.DS_Store)"
          }
        }
      }
    },
    "NASやクラウド同期を使っていると、名前が「.DS_Store 12-34-56」のように変わっていることがあります。これも同じものとして扱いますが、ファイルの中身を確認してFinderが作ったものだけを消すため、ご自分で付けた名前のファイルが消えることはありません。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a NAS or cloud sync, the name may change to something like “.DS_Store 12-34-56”. These are treated the same way, but the app checks each file's contents and deletes only what Finder created, so a file you named yourself is never removed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einem NAS oder einer Cloud-Synchronisierung kann sich der Name in etwa „.DS_Store 12-34-56“ ändern. Solche Dateien werden genauso behandelt; da die App jedoch den Dateiinhalt prüft und nur vom Finder erstellte Dateien löscht, werden selbst benannte Dateien niemals entfernt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menggunakan NAS atau sinkronisasi awan, namanya mungkin berubah menjadi seperti “.DS_Store 12-34-56”. Berkas ini diperlakukan sama, tetapi aplikasi memeriksa isi setiap berkas dan hanya menghapus yang dibuat oleh Finder, sehingga berkas yang Anda beri nama sendiri tidak akan pernah terhapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan NAS atau penyegerakan awan, nama mungkin berubah menjadi seperti “.DS_Store 12-34-56”. Fail ini dianggap sama, tetapi app menyemak kandungan setiap fail dan hanya memadam apa yang dicipta oleh Finder, jadi fail yang anda namakan sendiri tidak akan dipadam."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS나 클라우드 동기화를 사용하면 이름이 “.DS_Store 12-34-56”처럼 바뀌어 있을 때가 있어요. 이러한 파일도 똑같이 취급하지만, 파일 내용물을 확인해 Finder가 만든 것만 지우므로 직접 이름을 붙인 파일이 지워질 일은 없어요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en NAS eller sky-synkronisering kan navnet ændre sig til f.eks. “.DS_Store 12-34-56”. Disse behandles på samme måde, men appen tjekker hver fils indhold og sletter kun det, Finder har oprettet, så egne navngivne filer aldrig fjernes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อใช้ NAS หรือการซิงค์ผ่านคลาวด์ ชื่อไฟล์อาจเปลี่ยนเป็นเช่น “.DS_Store 12-34-56” แอปจะถือว่าเป็นไฟล์แบบเดียวกัน แต่จะตรวจเนื้อหาไฟล์และลบเฉพาะที่ Finder สร้างขึ้นเท่านั้น จึงไม่ลบไฟล์ที่คุณตั้งชื่อเอง"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 NAS 或雲端同步時，檔名可能會變成「.DS_Store 12-34-56」之類的名稱。這類檔案也會一併處理，但本程式會檢查檔案內容，只刪除由 Finder 建立的檔案，因此不會誤刪自行命名的檔案。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 NAS 或云同步时，文件名可能会变成“.DS_Store 12-34-56”之类。本应用会将其视为同类文件处理，但会先检查文件内容，仅删除由 Finder 生成的文件，因此不会误删自行命名的文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al usar un NAS o sincronización en la nube, el nombre puede cambiar a algo como «.DS_Store 12-34-56». Estos archivos se tratan del mismo modo, pero la app comprueba el contenido de cada archivo y elimina solo los creados por el Finder, por lo que nunca se borrará un archivo nombrado manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un NAS ou une synchronisation dans le nuage, le nom peut devenir « .DS_Store 12-34-56 ». Ces fichiers sont traités de la même façon, mais l’application vérifie le contenu de chacun et ne supprime que ceux créés par le Finder ; aucun fichier nommé par vos soins ne sera supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NAS या क्लाउड सिंक के साथ, नाम बदलकर “.DS_Store 12-34-56” जैसा हो सकता है। इन्हें भी वैसे ही माना जाता है, लेकिन ऐप हर फ़ाइल की सामग्री जाँचकर केवल Finder द्वारा बनाई गई फ़ाइलें ही हटाता है, इसलिए आपके द्वारा नाम दी गई कोई फ़ाइल कभी नहीं हटती।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi dùng NAS hoặc đồng bộ đám mây, tên tệp có thể đổi thành dạng như “.DS_Store 12-34-56”. Các tệp này cũng được xử lý tương tự, nhưng ứng dụng sẽ kiểm tra nội dung từng tệp và chỉ xóa tệp do Finder tạo ra, nên tệp do người dùng tự đặt tên sẽ không bao giờ bị xóa."
          }
        }
      }
    },
