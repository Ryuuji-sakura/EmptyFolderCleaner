    "%@をゴミ箱に入れました。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved %@ to the Trash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in den Papierkorb gelegt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dipindahkan ke Sampah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ telah dialihkan ke Tong Sampah."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 휴지통으로 이동했어요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttede %@ til Papirkurv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้าย %@ ไปที่ถังขยะแล้ว"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將 %@移到垃圾桶。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %@移到废纸篓。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movido a la Papelera: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placé dans la Corbeille : %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्दी में मूव किया गया: %@।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chuyển %@ vào Thùng rác."
          }
        }
      }
    },
    "%@をゴミ箱に移動します。間違えたときはゴミ箱から戻せます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be moved to the Trash. Anything moved by mistake can be put back from the Trash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgendes wird in den Papierkorb gelegt: %@. Versehentlich verschobene Objekte lassen sich aus dem Papierkorb zurücklegen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dipindahkan ke Sampah. Item yang tidak sengaja dipindahkan dapat dikembalikan dari Sampah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dialihkan ke Tong Sampah. Apa-apa yang tersalah alih boleh diletakkan semula daripada Tong Sampah."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 휴지통으로 이동해요. 실수로 이동한 항목은 휴지통에서 되돌려 놓을 수 있어요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ flyttes til Papirkurv. Elementer, der er flyttet ved en fejl, kan lægges tilbage fra Papirkurv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะย้าย %@ ไปที่ถังขยะ หากย้ายผิดสามารถนำกลับที่เดิมจากถังขยะได้"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即將把 %@移到垃圾桶。若誤刪，可從垃圾桶放回原處。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将把 %@移到废纸篓。如果误删，可以从废纸篓放回原处。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se moverá lo siguiente a la Papelera: %@. Lo que se mueva por error se puede sacar de la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacement dans la Corbeille : %@. En cas d’erreur, il est possible de tout remettre depuis la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्दी में मूव किया जाएगा: %@। गलती से मूव किए गए आइटम को रद्दी से वापस रखा जा सकता है।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ chuyển %@ vào Thùng rác. Nếu chuyển nhầm, có thể đặt lại từ Thùng rác."
          }
        }
      }
    },
    "%@を完全に削除しました。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deleted %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ endgültig gelöscht."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dihapus secara permanen."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ telah dipadam secara kekal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 완전히 삭제했어요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettede %@ permanent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %@ อย่างถาวรแล้ว"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已永久刪除 %@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已永久删除 %@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado permanentemente: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé définitivement : %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थायी रूप से हटाया गया: %@।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa vĩnh viễn %@."
          }
        }
      }
    },
    "%@を完全に削除します。ゴミ箱には入らず、元に戻せません。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be permanently deleted. This skips the Trash and cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgendes wird endgültig gelöscht: %@. Der Papierkorb wird übersprungen und der Vorgang kann nicht widerrufen werden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dihapus secara permanen. Tindakan ini melewati Sampah dan tidak dapat dibatalkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan dipadam secara kekal. Ini melangkau Tong Sampah dan tidak boleh dibuat asal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 완전히 삭제해요. 휴지통을 거치지 않으며 되돌릴 수 없어요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ slettes permanent. Dette går uden om Papirkurv og kan ikke fortrydes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะลบ %@ อย่างถาวรโดยไม่ผ่านถังขยะ และไม่สามารถเลิกทำได้"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即將永久刪除 %@。項目不會進入垃圾桶，且無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久删除 %@。项目不会进入废纸篓，且无法撤销。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará permanentemente lo siguiente: %@. Esta acción no pasa por la Papelera y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppression définitive : %@. Cette action ignore la Corbeille et est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थायी रूप से हटाया जाएगा: %@। इस प्रक्रिया में रद्दी का उपयोग नहीं होता और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ xóa vĩnh viễn %@. Thao tác này bỏ qua Thùng rác và không thể hoàn tác."
          }
        }
      }
    },
