    "Finderの設定ファイルだけが残っているフォルダも、空として削除する": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also delete folders that contain only a Finder settings file"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Ordner löschen, die nur eine Finder-Einstellungsdatei enthalten"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus juga folder yang hanya berisi berkas pengaturan Finder"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam juga folder yang hanya mengandungi fail tetapan Finder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 설정 파일만 남아 있는 폴더도 빈 폴더로 보고 삭제"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet også mapper, der kun indeholder en indstillingsfil til Finder"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบโฟลเดอร์ที่เหลือแต่ไฟล์การตั้งค่า Finder โดยถือว่าเป็นโฟลเดอร์ว่างด้วย"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅含 Finder 設定檔的資料夾也視為空資料夾刪除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅剩 Finder 设置文件的文件夹也视为空文件夹并删除"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar también las carpetas que solo contengan un archivo de ajustes del Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer aussi les dossiers ne contenant qu’un fichier de réglages du Finder"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल Finder सेटिंग्स फ़ाइल वाले फ़ोल्डर भी खाली मानकर हटाएँ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa cả thư mục chỉ còn tệp cài đặt Finder"
          }
        }
      }
    },
