        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel hat sich geändert, daher wurde der Vorgang abgebrochen. Die Liste prüfen und erneut versuchen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Target berubah, sehingga operasi dibatalkan. Periksa daftar dan coba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasaran telah berubah, jadi operasi dibatalkan. Semak senarai dan cuba lagi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상이 바뀌어 중단했어요. 내용을 확인한 다음 다시 실행해 주세요."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målet blev ændret, så handlingen blev annulleret. Gennemgå listen, og prøv igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการดำเนินการเนื่องจากเป้าหมายเปลี่ยนไป โปรดตรวจสอบรายการแล้วลองอีกครั้ง"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於目標已變更，作業已取消。請確認列表內容後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于目标已更改，操作已取消。请确认列表内容后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino cambió, por lo que se canceló la operación. Revisa la lista e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cible ayant changé, l’opération a été annulée. Vérifiez la liste et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य बदल जाने के कारण प्रक्रिया रद्द कर दी गई। सूची की जाँच करें और फिर से प्रयास करें।"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy thao tác vì thư mục đích đã thay đổi. Hãy kiểm tra lại danh sách rồi thực hiện lại."
          }
        }
      }
    },
    "対象のフォルダ %@": {
