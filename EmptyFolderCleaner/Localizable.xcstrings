    "「Finderの設定ファイル」とは": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is a “Finder settings file”?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist eine „Finder-Einstellungsdatei“?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa itu “berkas pengaturan Finder”?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah itu “fail tetapan Finder”?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“Finder 설정 파일”이란?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad er en “indstillingsfil til Finder”?"
          }
        },
        "th": {
          "stringUnit": {
